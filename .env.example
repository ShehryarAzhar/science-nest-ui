# Copy this file to .env and adjust the values for your machine.
# Both variables are required. The app refuses to start without them.

# Base URL of the Science Nest Django REST backend. Every backend path
# (e.g. /auth/jwt/create/) is appended to it.
# Format: absolute http(s) URL, no trailing slash.
# Example: https://api.example.com
API_BASE_URL=http://127.0.0.1:8000

# Public base URL of this frontend, used for absolute URLs
# (sitemap, Open Graph, metadata).
# Format: absolute http(s) URL, no trailing slash.
# Example: https://www.example.com
SITE_URL=http://localhost:3000
